      {
        "name": "Nudge the author",
        "nickname": "Nudge",
        "appliesTo": "pr",
        "body": "Hi @{{.Author}}, just checking in on the changes requested here. Is anything unclear, or anything blocking you? Happy to help.\n",
        "purpose": "reply",
