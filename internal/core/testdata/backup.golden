{
  "format": "nilbox.backup",
  "version": 1,
  "exportedAt": "2026-11-14T17:00:00Z",
  "app": "v1.2.3",
  "settings": {
    "defaultAgent": "claude",
    "defaultProfiles": {
      "claude": "default",
