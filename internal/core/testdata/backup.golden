      {
        "name": "Ask a question",
        "nickname": "Question",
        "appliesTo": "pr",
        "body": "Thanks, @{{.Author}}. I have a few questions before approving; see the comments below.\n",
        "purpose": "reply",
        "action": "comment",
        "models": {},
        "effort": "",
        "planMode": null,
        "worktree": null,
        "extraArgs": {},
