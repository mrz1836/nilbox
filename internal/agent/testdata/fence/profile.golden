# The argv and settings a Claude Code run gets under this tools preset. Rewrite with
# go test ./internal/agent -run TestFenceGoldens -update

argv:
  "--setting-sources"
  "user"
  "--permission-mode"
  "acceptEdits"
  "--strict-mcp-config"
  "--settings"
  "/Users/example/Library/Application Support/App/agent-runs/00000000-0000-4000-8000-000000000012/settings.json"
  "--session-id=00000000-0000-4000-8000-000000000012"

