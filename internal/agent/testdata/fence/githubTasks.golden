# The argv and settings a Claude Code run gets under this tools preset. Rewrite with
# go test ./internal/agent -run TestFenceGoldens -update

argv:
  "--setting-sources"
  ""
  "--tools"
  "Bash,Read"
  "--permission-mode"
  "dontAsk"
  "--strict-mcp-config"
  "--settings"
  "/Users/example/Library/Application Support/App/agent-runs/00000000-0000-4000-8000-000000000012/settings.json"
  "--session-id=00000000-0000-4000-8000-000000000012"

settings.json:
{
  "permissions": {
    "allow": [
      "Read",
      "Bash(gh pr checks:*)",
      "Bash(gh pr view:*)",
      "Bash(gh pr diff:*)",
      "Bash(gh pr list:*)",
      "Bash(gh pr status:*)",
      "Bash(gh run view:*)",
      "Bash(gh run list:*)",
      "Bash(gh issue view:*)",
      "Bash(gh issue list:*)",
      "Bash(gh issue status:*)",
      "Bash(gh repo view:*)",
      "Bash(gh workflow view:*)",
      "Bash(gh workflow list:*)",
      "Bash(gh label list:*)",
      "Bash(gh status:*)",
      "Bash(gh pr comment:*)",
      "Bash(gh pr edit:*)",
      "Bash(gh issue comment:*)",
      "Bash(gh issue edit:*)",
      "Bash(gh run rerun:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)",
      "Bash(git show:*)",
      "Bash(git rev-parse:*)",
      "Bash(git rev-list:*)",
      "Bash(git ls-files:*)",
      "Bash(git ls-tree:*)",
      "Bash(git blame:*)",
      "Bash(git grep:*)",
      "Bash(git describe:*)",
      "Bash(git merge-base:*)",
      "Bash(git cat-file:*)",
      "Bash(git shortlog:*)",
      "Bash(git show-ref:*)",
      "Bash(git for-each-ref:*)",
      "Bash(git name-rev:*)",
      "Bash(git branch:*)",
      "Bash(git tag:*)",
      "Bash(git remote:*)",
      "Bash(git config:*)",
      "Bash(git version:*)",
      "Bash(git help:*)",
      "Bash(git check-ignore:*)",
      "Bash(git check-attr:*)",
      "Bash(git worktree:*)",
      "Bash(git diff-tree:*)",
      "Bash(git diff-files:*)",
      "Bash(git diff-index:*)",
      "Bash(git count-objects:*)",
      "Bash(git reflog:*)",
      "Bash(git var:*)"
    ],
    "deny": [
      "WebFetch",
      "WebSearch",
      "Bash(curl:*)",
      "Bash(wget:*)",
      "Bash(nc:*)",
      "Bash(ncat:*)",
      "Bash(netcat:*)",
      "Bash(socat:*)",
      "Bash(telnet:*)",
      "Bash(ftp:*)",
      "Bash(sftp:*)",
