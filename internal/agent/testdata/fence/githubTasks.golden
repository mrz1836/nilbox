      "Bash(powershell -c:*)",
      "Bash(gh pr merge:*)",
      "Bash(gh pr review:*)",
      "Bash(gh pr close:*)",
      "Bash(gh pr reopen:*)",
      "Bash(gh issue close:*)",
      "Bash(gh issue delete:*)",
      "Bash(gh issue transfer:*)",
      "Bash(gh issue reopen:*)",
      "Bash(gh api:*)",
      "Bash(gh release:*)",
      "Bash(gh auth:*)",
      "Bash(gh secret:*)",
      "Bash(gh variable:*)",
      "Bash(gh ssh-key:*)",
      "Bash(gh gpg-key:*)",
      "Bash(gh extension:*)",
      "Bash(gh alias:*)",
      "Bash(gh config:*)",
      "Bash(gh repo delete:*)",
      "Bash(gh repo edit:*)",
      "Bash(gh repo rename:*)",
      "Bash(gh repo archive:*)",
      "Bash(gh repo unarchive:*)",
      "Bash(gh repo create:*)",
