      "Bash(gh workflow enable:*)",
      "Bash(gh workflow disable:*)",
      "Bash(gh cache delete:*)",
      "Bash(gh run cancel:*)",
      "Bash(gh run delete:*)",
      "Bash(gh codespace:*)",
      "Bash(gh gist:*)",
      "Bash(gh ruleset:*)",
      "Bash(gh label create:*)",
      "Bash(gh label edit:*)",
      "Bash(gh label delete:*)",
      "Bash(gh label clone:*)",
      "Bash(gh project:*)",
      "Bash(gh org:*)",
      "Bash(gh attestation:*)",
      "Bash(gh agent-task:*)",
      "Bash(gh copilot:*)",
      "Bash(git -C:*)",
      "Bash(git -c:*)",
      "Bash(git --git-dir:*)",
      "Bash(git --work-tree:*)",
      "Bash(git config --global:*)",
      "Bash(git remote add:*)",
      "Bash(git remote set-url:*)",
      "Bash(git remote remove:*)",
      "Bash(git remote rename:*)",
      "Bash(git update-ref:*)",
      "Bash(git submodule:*)",
      "Bash(git push:*)",
      "Edit",
      "Write",
      "NotebookEdit"
    ],
    "disableBypassPermissionsMode": "disable"
  },
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "*",
        "hooks": [
          {
            "type": "command",
            "command": "/Applications/App.app/Contents/MacOS/App",
            "args": [
              "--fence-hook-v1=/Users/example/Library/Application Support/App/agent-runs/00000000-0000-4000-8000-000000000012"
            ],
            "timeout": 30,
            "onFailure": "block"
          }
        ]
      }
    ]
  },
  "disableAllHooks": false,
  "attribution": {
    "commit": "",
    "pr": ""
  },
  "includeCoAuthoredBy": false,
  "enableAllProjectMcpServers": false
}
