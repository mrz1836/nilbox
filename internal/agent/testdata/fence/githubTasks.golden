      "Bash(http:*)",
      "Bash(https:*)",
      "Bash(xh:*)",
      "Bash(aria2c:*)",
      "Bash(lynx:*)",
      "Bash(links:*)",
      "Bash(w3m:*)",
      "Bash(sudo:*)",
      "Bash(doas:*)",
      "Bash(su:*)",
      "Bash(pkexec:*)",
      "Bash(runuser:*)",
      "Bash(osascript:*)",
      "Bash(eval:*)",
      "Bash(sh -c:*)",
