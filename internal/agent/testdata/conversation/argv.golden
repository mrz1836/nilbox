# The argv each turn of a conversation passes Claude Code, its prompt on stdin: the first turn,
# then one that resumes it. Rewrite with
# go test ./internal/agent -run TestTheConversationsArgv -update

first turn:
  "-p"
  "--output-format"
  "stream-json"
  "--verbose"
  "--permission-prompts"
  "none"
  "--session-id"
  "00000000-0000-4000-8000-000000000001"
  "--name"
  "App: Describe it"
  "--model"
  "haiku"
  "--effort"
  "low"
  "--tools"
  ""
  "--restricted"
  "--strict-mcp-config"
  "--mcp-config"
  "/Users/example/Library/Application Support/App/describe/conversations/00000000-0000-4000-8000-000000000001/mcp.json"
  "--permission-mode"
  "dontAsk"
  "--allowedTools"
  "mcp__app"
  "--max-budget-usd"
  "0.5"
  "--append-system-prompt-file"
  "/Users/example/Library/Application Support/App/describe/conversations/00000000-0000-4000-8000-000000000001/instructions.md"
  "--system-prompt-snapshot"
  "off"

resumed turn:
  "-p"
  "--output-format"
  "stream-json"
  "--verbose"
  "--permission-prompts"
  "none"
  "--resume"
  "00000000-0000-4000-8000-000000000001"
  "--name"
  "App: Describe it"
  "--model"
  "haiku"
  "--effort"
  "low"
  "--tools"
  ""
  "--restricted"
  "--strict-mcp-config"
  "--mcp-config"
  "/Users/example/Library/Application Support/App/describe/conversations/00000000-0000-4000-8000-000000000001/mcp.json"
  "--permission-mode"
  "dontAsk"
  "--allowedTools"
  "mcp__app"
  "--max-budget-usd"
  "0.5"
  "--append-system-prompt-file"
  "/Users/example/Library/Application Support/App/describe/conversations/00000000-0000-4000-8000-000000000001/instructions.md"
  "--system-prompt-snapshot"
  "off"
