{
    "version": 1,
    "watch": {
        "sources": [
            {
                "search": {
                    "kind": "pr",
                    "authors": [
                        "app/dependabot"
                    ],
                    "where": [
                        "@me"
                    ]
                }
            }
        ]
    },
    "trigger": {
        "event": "checks_failed",
        "waitForChecks": true
    },
    "conditions": {
        "match": "all",
        "of": [
            {
                "field": "dep.updateType",
                "op": "oneOf",
                "values": [
                    "patch",
                    "minor"
                ]
            }
        ]
    },
    "steps": [
        {
            "agent": {
                "agent": "inherit",
                "prompt": {
                    "starter": "heal-dependabot-pr"
                },
                "where": "background",
                "fence": {
                    "budget": {
                        "usd": 3
                    },
                    "timeoutMinutes": 30,
                    "tools": "editTestPush"
                }
            }
        },
        {
            "waitForChecks": {
                "settleMinutes": 2,
                "giveUpHours": 2
            },
            "onlyIf": "pushed"
        },
        {
            "merge": {
                "how": "autoMergeIfItWasOn"
            },
            "onlyIf": "passed"
        },
        {
            "tellMe": {},
            "onlyIf": "stillFails"
        }
    ],
    "limits": {
        "oncePer": "headCommit",
        "triesPerItem": 2,
        "runsPerDay": 10
    }
}
