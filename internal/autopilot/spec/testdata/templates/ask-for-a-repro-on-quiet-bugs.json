{
    "version": 1,
    "watch": {
        "sources": [
            {
                "lists": [
                    "assigned"
                ]
            }
        ]
    },
    "trigger": {
        "event": "goes_quiet",
        "days": 14
    },
    "conditions": {
        "match": "all",
        "of": [
            {
                "field": "item.kind",
                "op": "oneOf",
                "values": [
                    "issue"
                ]
            },
            {
                "field": "item.labels",
                "op": "hasAny",
                "values": [
                    "bug"
                ]
            },
            {
                "field": "item.labels",
                "op": "hasNone",
                "values": [
                    "needs-repro"
                ]
            }
        ]
    },
    "steps": [
        {
            "github": [
                {
                    "reply": {
                        "prompt": {
                            "nickname": "Question"
                        }
                    }
                },
                {
                    "labels": {
                        "add": [
                            "needs-repro"
                        ]
                    }
                }
            ]
        }
    ],
    "limits": {}
}
