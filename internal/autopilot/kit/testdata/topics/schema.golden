# The proposal's JSON Schema

Draft 2020-12, generated from this build's format: every key, every closed set of values, and the ranges the catalog sets.

```json
{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Nilbox Autopilot proposal",
  "description": "What a coding agent proposes for the user to review in the Autopilot tab: new prompts, new routines and changes to routines, a change to Autopilot's settings, and a change to the rules routines lean on, applied in that order once the user applies each.",
  "$ref": "#/$defs/Proposal",
  "$defs": {
    "Proposal": {
      "type": "object",
      "properties": {
        "summary": {
          "description": "One or two sentences the card shows first.",
          "type": "string"
        },
        "prompts": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/NewPrompt"
          }
        },
        "routines": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/RoutineChange"
          }
        },
        "settings": {
          "$ref": "#/$defs/SettingsChange"
        },
        "rules": {
          "$ref": "#/$defs/RulesChange"
        }
      },
      "required": [
        "summary"
      ],
      "additionalProperties": false
    },
    "NewPrompt": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "nickname": {
          "type": "string",
          "maxLength": 20
        },
        "purpose": {
          "type": "string",
          "enum": [
            "agent",
            "reply"
          ]
        },
        "replyAction": {
          "type": "string",
          "enum": [
            "approve",
            "request_changes",
            "comment"
          ]
        },
        "appliesTo": {
          "type": "string",
          "enum": [
            "pr",
            "issue",
            "any"
          ]
        },
        "body": {
          "description": "A Go template, at most 32768 bytes.",
          "type": "string"
        }
      },
      "required": [
        "name",
        "nickname",
        "purpose",
        "appliesTo",
        "body"
      ],
      "additionalProperties": false
    },
    "RoutineChange": {
      "type": "object",
      "properties": {
        "id": {
          "description": "The routine a change changes; left out for a new one.",
          "type": "integer",
          "minimum": 1
        },
        "base": {
          "description": "The routine's updatedAt as autopilot_my_setup gives it, for a change.",
          "type": "string"
        },
        "name": {
          "type": "string",
          "maxLength": 80
        },
        "description": {
          "type": "string",
          "maxLength": 500
        },
        "mode": {
          "description": "The mode a new routine is suggested to start in: a hint the card shows, never applied.",
          "type": "string",
          "enum": [
            "dryRun",
            "ask",
            "auto"
          ]
        },
        "template": {
          "type": "string"
        },
        "spec": {
          "$ref": "#/$defs/Spec"
        }
      },
      "required": [
        "name",
        "spec"
      ],
      "additionalProperties": false
    },
    "Spec": {
      "type": "object",
      "properties": {
        "version": {
          "type": "integer",
          "const": 1
        },
        "watch": {
          "$ref": "#/$defs/Watch"
        },
        "trigger": {
          "$ref": "#/$defs/Trigger"
        },
        "conditions": {
          "$ref": "#/$defs/Conditions"
        },
        "steps": {
          "type": "array",
          "minItems": 1,
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/Step"
          }
        },
        "limits": {
          "$ref": "#/$defs/Limits"
        },
        "notify": {
          "$ref": "#/$defs/Notices"
        },
        "requires": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "version",
        "watch",
        "trigger",
        "conditions",
        "steps",
        "limits"
      ],
      "additionalProperties": false
    },
    "Watch": {
      "type": "object",
      "properties": {
        "sources": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "$ref": "#/$defs/Source"
          }
        }
      },
      "required": [
        "sources"
      ],
      "additionalProperties": false
    },
    "Source": {
      "description": "exactly one of lists and search",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "lists": {
          "type": "array",
          "items": {
            "type": "string",
            "enum": [
              "reviewRequested",
              "authored",
              "assigned"
            ]
          }
        },
        "search": {
          "$ref": "#/$defs/Search"
        }
      },
      "additionalProperties": false
    },
    "Search": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "pr",
            "issue"
          ]
        },
        "authors": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string"
          }
        },
        "where": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string"
          }
        },
        "involving": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "enum": [
              "assigned",
              "reviewRequested",
              "mentioned"
            ]
          }
        },
        "labels": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string"
          }
        },
        "notLabels": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string"
          }
        },
        "base": {
          "type": "string"
        },
        "headPrefix": {
          "type": "string"
        },
        "state": {
          "type": "array",
          "maxItems": 10,
          "items": {
            "type": "string",
            "enum": [
              "ready",
              "draft",
              "failing",
              "passing",
              "pending",
              "changesRequested",
              "approved",
              "reviewRequired",
              "unreviewed"
            ]
          }
        },
        "more": {
          "type": "string",
          "maxLength": 200
        }
      },
      "additionalProperties": false
    },
    "Trigger": {
      "type": "object",
      "properties": {
        "event": {
          "type": "string",
          "enum": [
            "appears",
            "new_commits",
            "checks_failed",
            "checks_passed",
            "changes_requested",
            "approved",
            "merge_conflicts",
            "falls_behind",
            "labeled",
            "ready_for_review",
            "review_requested",
            "assigned",
            "new_comments",
            "goes_quiet",
            "schedule",
            "manual"
          ]
        },
        "waitForChecks": {
          "type": "boolean"
        },
        "settleMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "firstToo": {
          "type": "boolean"
        },
        "ownPushesToo": {
          "type": "boolean"
        },
        "count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        },
        "label": {
          "type": "string",
          "maxLength": 50
        },
        "schedule": {
          "$ref": "#/$defs/Schedule"
        }
      },
      "required": [
        "event"
      ],
      "additionalProperties": false
    },
    "Schedule": {
      "type": "object",
      "properties": {
        "every": {
          "type": "string",
          "enum": [
            "day",
            "weekday",
            "week"
          ]
        },
        "at": {
          "description": "The time of day, HH:MM on a 24-hour clock.",
          "type": "string"
        },
        "on": {
          "type": "string",
          "enum": [
            "mon",
            "tue",
            "wed",
            "thu",
            "fri",
            "sat",
            "sun"
          ]
        },
        "style": {
          "type": "string",
          "enum": [
            "each",
            "digest"
          ]
        }
      },
      "required": [
        "every",
        "at"
      ],
      "additionalProperties": false
    },
    "Conditions": {
      "type": "object",
      "properties": {
        "match": {
          "type": "string",
          "enum": [
            "all",
            "any"
          ]
        },
        "of": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/Clause"
          }
        }
      },
      "required": [
        "match",
        "of"
      ],
      "additionalProperties": false
    },
    "Clause": {
      "description": "a condition (field, op, and value or values), or a group",
      "type": "object",
      "properties": {
        "field": {
          "type": "string",
          "enum": [
            "item.kind",
            "item.title",
            "item.labels",
            "item.author",
            "item.authorIsBot",
            "item.trust",
            "item.association",
            "item.age",
            "item.idle",
            "item.comments",
            "item.lists",
            "item.snoozed",
            "item.dismissed",
            "item.pinned",
            "item.mine",
            "repo.owner",
            "repo.name",
            "repo.fullName",
            "repo.visibility",
            "repo.language",
            "repo.fork",
            "repo.permission",
            "repo.hasClone",
            "repo.muted",
            "repo.pinned",
            "repo.allowsUpdateBranch",
            "pr.draft",
            "pr.base",
            "pr.head",
            "pr.fromFork",
            "pr.size",
            "pr.lines",
            "pr.files",
            "pr.commits",
            "pr.conflicts",
            "pr.behind",
            "pr.reviewDecision",
            "pr.approvals",
            "pr.changesRequested",
            "pr.asksMe",
            "pr.autoMerge",
            "checks.state",
            "checks.failed",
            "checks.pending",
            "checks.passed",
            "checks.failedNames",
            "checks.names",
            "checks.requiredFailed",
            "checks.awaitingApproval",
            "files.paths",
            "files.sensitive",
            "dep.tool",
            "dep.ecosystem",
            "dep.package",
            "dep.from",
            "dep.to",
            "dep.updateType",
            "dep.grouped",
            "dep.security",
            "history.tries",
            "history.lastOutcome"
          ]
        },
        "op": {
          "type": "string",
          "enum": [
            "is",
            "isNot",
            "contains",
            "notContains",
            "startsWith",
            "matches",
            "matchesRegex",
            "hasAny",
            "hasAll",
            "hasNone",
            "anyContains",
            "noneContains",
            "anyMatches",
            "allMatch",
            "isEmpty",
            "notEmpty",
            "eq",
            "ne",
            "lt",
            "lte",
            "gt",
            "gte",
            "isYes",
            "isNo",
            "oneOf",
            "noneOf",
            "moreThan",
            "lessThan"
          ]
        },
        "value": {
          "type": "string",
          "maxLength": 200
        },
        "values": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string"
          }
        },
        "group": {
          "$ref": "#/$defs/Conditions"
        }
      },
      "additionalProperties": false
    },
    "Step": {
      "description": "exactly one kind of step, and onlyIf",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 2,
      "properties": {
        "notify": {
          "$ref": "#/$defs/NotifyStep"
        },
        "pin": {
          "$ref": "#/$defs/Empty"
        },
        "snooze": {
          "$ref": "#/$defs/SnoozeStep"
        },
        "dismiss": {
          "$ref": "#/$defs/Empty"
        },
        "restore": {
          "$ref": "#/$defs/Empty"
        },
        "markDone": {
          "$ref": "#/$defs/Empty"
        },
        "github": {
          "type": "array",
          "minItems": 1,
          "maxItems": 4,
          "items": {
            "$ref": "#/$defs/GitHubAction"
          }
        },
        "agent": {
          "$ref": "#/$defs/AgentStep"
        },
        "waitForChecks": {
          "$ref": "#/$defs/WaitStep"
        },
        "merge": {
          "$ref": "#/$defs/MergeStep"
        },
        "postReview": {
          "$ref": "#/$defs/ReviewStep"
        },
        "tellMe": {
          "$ref": "#/$defs/TellStep"
        },
        "script": {
          "$ref": "#/$defs/ScriptStep"
        },
        "onlyIf": {
          "type": "string",
          "enum": [
            "passed",
            "stillFails",
            "pushed",
            "notPushed",
            "approve",
            "requestChanges"
          ]
        }
      },
      "additionalProperties": false
    },
    "NotifyStep": {
      "type": "object",
      "properties": {
        "note": {
          "type": "string",
          "maxLength": 200
        },
        "banner": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "Empty": {
      "description": "no keys: {}",
      "type": "object",
      "additionalProperties": false
    },
    "SnoozeStep": {
      "type": "object",
      "properties": {
        "days": {
          "type": "integer",
          "minimum": 1,
          "maximum": 365
        }
      },
      "additionalProperties": false
    },
    "GitHubAction": {
      "description": "exactly one action",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "rebase": {
          "$ref": "#/$defs/Empty"
        },
        "updateBranch": {
          "$ref": "#/$defs/Empty"
        },
        "reply": {
          "$ref": "#/$defs/ReplyAction"
        },
        "labels": {
          "$ref": "#/$defs/LabelsAction"
        }
      },
      "additionalProperties": false
    },
    "ReplyAction": {
      "type": "object",
      "properties": {
        "prompt": {
          "$ref": "#/$defs/PromptRef"
        }
      },
      "required": [
        "prompt"
      ],
      "additionalProperties": false
    },
    "PromptRef": {
      "description": "exactly one of starter, nickname, and itemDefault",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "starter": {
          "type": "string"
        },
        "nickname": {
          "type": "string"
        },
        "itemDefault": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "LabelsAction": {
      "type": "object",
      "properties": {
        "add": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string"
          }
        },
        "remove": {
          "type": "array",
          "maxItems": 20,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "AgentStep": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string"
        },
        "prompt": {
          "$ref": "#/$defs/PromptRef"
        },
        "where": {
          "type": "string",
          "enum": [
            "background",
            "terminal"
          ]
        },
        "profile": {
          "type": "string"
        },
        "fallbacks": {
          "type": "array",
          "maxItems": 3,
          "items": {
            "$ref": "#/$defs/ProfileRef"
          }
        },
        "model": {
          "type": "string"
        },
        "effort": {
          "type": "string"
        },
        "planMode": {
          "type": "boolean"
        },
        "worktree": {
          "type": "boolean"
        },
        "launchFor": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "$ref": "#/$defs/LaunchRow"
          }
        },
        "fence": {
          "$ref": "#/$defs/Fence"
        }
      },
      "required": [
        "prompt"
      ],
      "additionalProperties": false
    },
    "ProfileRef": {
      "type": "object",
      "properties": {
        "agent": {
          "type": "string"
        },
        "profile": {
          "type": "string",
          "maxLength": 200
        }
      },
      "required": [
        "agent",
        "profile"
      ],
      "additionalProperties": false
    },
    "LaunchRow": {
      "type": "object",
      "properties": {
        "target": {
          "type": "string"
        },
        "agent": {
          "type": "string"
        },
        "profile": {
          "type": "string"
        },
        "model": {
          "type": "string"
        },
        "effort": {
          "type": "string"
        }
      },
      "required": [
        "target"
      ],
      "additionalProperties": false
    },
    "Fence": {
      "type": "object",
      "properties": {
        "budget": {
          "$ref": "#/$defs/Budget"
        },
        "timeoutMinutes": {
          "type": "integer",
          "minimum": 5,
          "maximum": 180
        },
        "tools": {
          "type": "string",
          "enum": [
            "readOnly",
            "githubTasks",
            "editTest",
            "editTestPush",
            "profile"
          ]
        },
        "allow": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string"
          }
        },
        "deny": {
          "type": "array",
          "maxItems": 50,
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false
    },
    "Budget": {
      "description": "exactly one of usd and tokens",
      "type": "object",
      "minProperties": 1,
      "maxProperties": 1,
      "properties": {
        "usd": {
          "description": "An agent step's fence takes $0.50 to $50 or 10000 to 50000000 tokens; a routine's daily budget $1 to $500 or 100000 to 50000000 tokens. Dollars go to the cent.",
          "type": "number"
        },
        "tokens": {
          "description": "An agent step's fence takes $0.50 to $50 or 10000 to 50000000 tokens; a routine's daily budget $1 to $500 or 100000 to 50000000 tokens. Dollars go to the cent.",
          "type": "integer"
        }
      },
      "additionalProperties": false
    },
    "WaitStep": {
      "type": "object",
      "properties": {
        "settleMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 60
        },
        "giveUpHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 24
        }
      },
      "additionalProperties": false
    },
    "MergeStep": {
      "type": "object",
      "properties": {
        "how": {
          "type": "string",
          "enum": [
            "autoMergeIfItWasOn",
            "whenMergeable"
          ]
        },
        "method": {
          "type": "string",
          "enum": [
            "merge",
            "squash",
            "rebase"
          ]
        },
        "allowBypass": {
          "type": "boolean"
        },
        "allowSensitive": {
          "type": "boolean"
        }
      },
      "required": [
        "how"
      ],
      "additionalProperties": false
    },
    "ReviewStep": {
      "type": "object",
      "properties": {
        "as": {
          "type": "string",
          "enum": [
            "comment",
            "verdict"
          ]
        },
        "allowApprove": {
          "description": "Lets a verdict approve; only with as verdict.",
          "type": "boolean"
        }
      },
      "required": [
        "as"
      ],
      "additionalProperties": false
    },
    "TellStep": {
      "type": "object",
      "properties": {
        "when": {
          "type": "string",
          "enum": [
            "reached",
            "verdict"
          ]
        }
      },
      "additionalProperties": false
    },
    "ScriptStep": {
      "type": "object",
      "properties": {
        "id": {
          "type": "integer",
          "minimum": 1
        },
        "name": {
          "type": "string"
        }
      },
      "required": [
        "id",
        "name"
      ],
      "additionalProperties": false
    },
    "Limits": {
      "type": "object",
      "properties": {
        "oncePer": {
          "type": "string",
          "enum": [
            "item",
            "headCommit",
            "day"
          ]
        },
        "triesPerItem": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10
        },
        "runsPerDay": {
          "type": "integer",
          "minimum": 1,
          "maximum": 100
        },
        "waitMinutes": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1440
        },
        "activeHours": {
          "$ref": "#/$defs/ActiveHours"
        },
        "budgetPerDay": {
          "$ref": "#/$defs/Budget"
        }
      },
      "additionalProperties": false
    },
    "ActiveHours": {
      "type": "object",
      "properties": {
        "days": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "enum": [
              "mon",
              "tue",
              "wed",
              "thu",
              "fri",
              "sat",
              "sun"
            ]
          }
        },
        "from": {
          "type": "string"
        },
        "to": {
          "type": "string"
        }
      },
      "required": [
        "days",
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "Notices": {
      "type": "object",
      "properties": {
        "alert": {
          "type": "boolean"
        },
        "needsYou": {
          "type": "boolean"
        },
        "finished": {
          "type": "boolean"
        },
        "checks": {
          "type": "boolean"
        },
        "problem": {
          "type": "boolean"
        }
      },
      "additionalProperties": false
    },
    "SettingsChange": {
      "type": "object",
      "properties": {
        "defaultMode": {
          "type": "string",
          "enum": [
            "dryRun",
            "ask",
            "auto"
          ]
        },
        "agentsAtOnce": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "runsPerDay": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "actionsPerDay": {
          "type": "integer",
          "minimum": 1,
          "maximum": 200
        },
        "dailyCap": {
          "$ref": "#/$defs/DailyCap"
        },
        "keepAwake": {
          "type": "boolean"
        },
        "holdOnOutage": {
          "type": "boolean"
        },
        "catchUpHours": {
          "type": "integer",
          "minimum": 1,
          "maximum": 168
        },
        "historyDays": {
          "type": "integer",
          "minimum": 7,
          "maximum": 365
        },
        "logDays": {
          "type": "integer",
          "minimum": 1,
          "maximum": 90
        }
      },
      "additionalProperties": false
    },
    "DailyCap": {
      "type": "object",
