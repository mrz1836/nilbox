// tasks.json as an editor writes it: comments, trailing commas, and every case of the
// subset the app reads.
{
    "version": "2.0.0",
    /* the inputs the tasks below use */
    "inputs": [
        {"id": "bump", "type": "pickString", "options": ["patch", {"label": "Minor", "value": "minor"}], "default": "patch"},
        {"id": "note", "type": "promptString", "description": "A note", "default": "hello"},
        {"id": "secret", "type": "promptString", "password": true},
        {"id": "picked", "type": "command", "command": "extension.pick"},
    ],
    "tasks": [
        {"label": "plain", "type": "shell", "command": "magex lint", "detail": "Lint it", "problemMatcher": ["$go"], "group": "build"},
        {"label": "with args", "type": "shell", "command": "echo", "args": ["two words", {"value": "it's", "quoting": "strong"}]},
        {"label": "own shell", "type": "shell", "command": "magex test", "options": {"shell": {"executable": "/bin/bash", "args": ["-l", "-c"]}}},
        {"label": "shell no args", "type": "shell", "command": "magex test", "options": {"shell": {"executable": "zsh"}}},
        {"label": "on macOS", "type": "shell", "command": "linux-only", "options": {"env": {"OWN": "task", "SHARED": "task"}},
         "osx": {"command": "mac-only", "options": {"env": {"SHARED": "osx"}}}},
        {"label": "process", "type": "process", "command": "/usr/bin/true", "args": ["--flag", "${workspaceFolder}/out"]},
        {"label": "in a folder", "type": "shell", "command": "make", "options": {"cwd": "${workspaceFolder}/sub", "env": {"ROOT": "${workspaceFolderBasename}", "HOME_DIR": "${userHome}", "PATH_TOO": "${env:PATH}${pathSeparator}x"}}},
        {"label": "bump", "type": "shell", "command": "magex version:bump bump=${input:bump} note=${input:note}"},
        {"label": "file", "type": "shell", "command": "go test ${file}"},
        {"label": "command var", "type": "shell", "command": "run ${command:pickFile}"},
        {"label": "config var", "type": "shell", "command": "run ${config:go.gopath}"},
        {"label": "password", "type": "shell", "command": "login ${input:secret}"},
        {"label": "command input", "type": "shell", "command": "run ${input:picked}"},
        {"label": "missing input", "type": "shell", "command": "run ${input:nowhere}"},
        {"label": "npm", "type": "npm", "script": "build"},
        {"label": "no type", "command": "magex lint"},
        {"label": "bad env", "type": "shell", "command": "x", "options": {"env": {"NOT-A-NAME": "1"}}},
        {"label": "serve", "type": "shell", "command": "magex docs:serve", "isBackground": true},
        {"label": "sequence", "dependsOn": ["plain", "with args"], "dependsOrder": "sequence"},
        {"label": "parallel", "type": "shell", "command": "echo done", "dependsOn": ["plain", "own shell"]},
        {"label": "nested", "dependsOn": "sequence", "type": "shell", "command": "echo nested"},
        {"label": "diamond", "dependsOn": ["sequence", "plain"], "dependsOrder": "sequence"},
        {"label": "on greyed", "dependsOn": ["file"]},
        {"label": "on missing", "dependsOn": ["nowhere"]},
        {"label": "on background", "dependsOn": ["serve"], "type": "shell", "command": "echo after"},
        {"label": "loop a", "dependsOn": ["loop b"]},
        {"label": "loop b", "dependsOn": ["loop a"]},
        {"label": "by type", "dependsOn": [{"type": "npm", "script": "build"}]},
        {"label": "empty", "type": "shell"},
        {"label": "plain", "type": "shell", "command": "a second plain"},
        {"type": "shell", "command": "no label"},
        {"label": "odd command", "type": "shell", "command": 42},
        {"label": "unreadable", "type": "shell", "command": "x", "args": "not a list"},
    ],
}
