#!/bin/sh
# Generated by <brand.Name> to run a command it follows. Safe to delete.
set -u
finish() {
  printf '%s\n' "$1" > '/data/script-runs/43.exit.tmp' && mv '/data/script-runs/43.exit.tmp' '/data/script-runs/43.exit'
  exit "$1"
}
