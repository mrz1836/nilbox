# The script POSIXRenderer.Render writes for this case, after this header, with
# <brand.Name> for the product name. Rewrite with
# go test ./internal/launcher/terminal -run TestRenderGolden -update

#!/bin/sh
# Generated by <brand.Name> to run a command it follows. Safe to delete.
set -u
finish() {
  printf '%s\n' "$1" > '/data/script runs/it'\''s 7.exit.tmp' && mv '/data/script runs/it'\''s 7.exit.tmp' '/data/script runs/it'\''s 7.exit'
  exit "$1"
}
printf '%s\n' "$$" > '/data/script runs/it'\''s 7.pid'
cd -- '/work/projects/it'\''s a repo' || finish 1
unset GIT_DIR
export NOTE='it'\''s $HOME'
export NO_COLOR='1'
/usr/bin/script -q -F '/data/script runs/it'\''s 7.log' '/work/bin/my tools/magex' 'version:bump' 'message=it'\''s two words' '$HOME' '#7'
finish "$?"
