# The script POSIXRenderer.Render writes for this case, after this header, with
# <brand.Name> for the product name. Rewrite with
# go test ./internal/launcher/terminal -run TestRenderGolden -update

#!/bin/sh
# Generated by <brand.Name> to run a command it follows. Safe to delete.
set -u
finish() {
  printf '%s\n' "$1" > '/data/script-runs/42.exit.tmp' && mv '/data/script-runs/42.exit.tmp' '/data/script-runs/42.exit'
  exit "$1"
}
printf '%s\n' "$$" > '/data/script-runs/42.pid'
cd -- '/work/projects/sdk' || finish 1
export MAGEX_NO_UPDATE_CHECK='1'
/usr/bin/script -q -F '/data/script-runs/42.log' '/work/bin/magex' 'version:bump' 'bump=patch' 'branch=master' 'push=true'
finish "$?"
