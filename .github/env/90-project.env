# ================================================================================================
# 🏗️ PROJECT-SPECIFIC CONFIGURATION (90-project.env)
# ================================================================================================
#
# Purpose: Project-specific overrides for nilbox
# Load Order: 90 (loaded near-last, overrides all default and tool-specific settings)
#
# This file contains configuration values unique to this project that override
# defaults from earlier env files (00-core, 10-*, 20-*).
#
# Only add variables here that differ from the upstream defaults.
#
# ================================================================================================

# ================================================================================================
# 🎯 GO VERSION CONFIGURATION
# ================================================================================================

# Project Go versions (overrides 00-core.env defaults)
GO_PRIMARY_VERSION=1.26.x
GO_SECONDARY_VERSION=1.26.x

# ================================================================================================
# 🪄 MAGE-X GO VERSION OVERRIDES
# ================================================================================================

MAGE_X_GO_VERSION=1.26.x
MAGE_X_GO_SECONDARY_VERSION=1.26.x

# ================================================================================================
# 📊 COVERAGE OVERRIDES
# ================================================================================================

# Coverage provider (overrides 10-coverage.env default of "internal")
GO_COVERAGE_PROVIDER=codecov

# Codecov requires a token for this project
CODECOV_TOKEN_REQUIRED=true

# Coverage exclusion paths (aligned with codecov.yml ignore paths)
# magefiles/ is measured: its targets are tested under the mage build tag, with fake tools
# standing in for pnpm, go, rsvg-convert, and the macOS-only commands.
GO_COVERAGE_EXCLUDE_PATHS=.github/,.mage-cache/,.vscode/,bin/,example/,examples/,mocks/,testing/,test/,vendor/,testdata/,plans/,docs/

# Skip URL checks in coverage reports
GO_COVERAGE_SKIP_URL_CHECKS=true

# ================================================================================================
# 🖥️ DESKTOP SHELL ISOLATION
# ================================================================================================

# The desktop shell (Wails, CGO/webkit) lives behind the `desktop` build tag. Tag auto-discovery
# runs one combined pass, so `desktop` and Wails' own `production` release tag are excluded here
# to keep CI builds, tests, and lint pure Go. `integration` is excluded too: tests behind it run
# the real magex and go-pre-commit, and only `magex test:integration` runs them. This replaces the
# default list, so every default entry from 10-mage-x.env is kept.
MAGE_X_AUTO_DISCOVER_BUILD_TAGS_EXCLUDE=race,custom,msan,asan,cgo,gc,gccgo,boringcrypto,unix,aix,android,darwin,dragonfly,freebsd,hurd,illumos,ios,js,linux,nacl,netbsd,openbsd,plan9,solaris,wasip1,windows,zos,386,amd64,amd64p32,arm,armbe,arm64,arm64be,loong64,mips,mipsle,mips64,mips64le,mips64p32,mips64p32le,ppc,ppc64,ppc64le,riscv,riscv64,s390,s390x,sparc,sparc64,wasm,desktop,production,integration

# The frontend/ tree is formatted by Prettier; excluding it keeps the Go-side formatters from
# rewriting its JSON and YAML files.
MAGE_X_FORMAT_EXCLUDE_PATHS=vendor,node_modules,.git,.idea,frontend

# ================================================================================================
# 🗃️ SQLC
# ================================================================================================

# sqlc generates each table owner's typed queries from its SQL and the migrations (sqlc.yaml).
# `magex db:generate` and `magex db:check` build this version with `go run`, so sqlc never enters
# go.mod; the generated files name it, and a repoguard test fails when they name another.
SQLC_VERSION=v1.31.1
