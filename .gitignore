# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib

# Test binary, build with `go test -c`
*.test

# Go List
go.list

# Output of the go coverage tool, specifically when used with LiteIDE
*.out

# OS files
*.db
*.DS_Store

# Jetbrains
.idea/

# Eclipse
.project

# Notes
todo.md

# Distribution
dist

# Code coverage
coverage.txt
coverage.out

# Fuzz test corpora (recorded test fixtures under testdata/ are committed)
**/testdata/fuzz/

# Node modules
node_modules/

# Signing keys and certificates never enter the repository: magex app:keygen writes the
# release key outside it, and a code-signing certificate is exported as a .p12
*.p12
*.key
release.key

# Build output and local build caches (magex build writes the headless binary into cmd/nilbox/,
# and magex app:package each release into bin/release/<version>/)
/bin/
/cmd/nilbox/nilbox
.mage-cache/

# Frontend build artifacts
frontend/coverage/
*.tsbuildinfo

# Plans
.plans/
